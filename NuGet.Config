<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Every package used by this repository comes from nuget.org, so restore uses it alone.
    The GitHub Packages feed is only a publishing target and needs no restore source; push with
      dotnet nuget push <package>.nupkg -s https://nuget.pkg.github.com/Tynab/index.json -k $GITHUB_TOKEN
    (-s is short for source, -k for api-key).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
